{{- if eq .env "gip" }}
output "BNQ BenQ BL2790QT L7P01778019" alias $right
output "BNQ BenQ BL3290QT F7P00718019" alias $center
output "BNQ BenQ BL2790QT L7P01760019" alias $left
output "BOE 0x0A85 Unknown" alias $laptop
output "BNQ BenQ GW2480 ETN9P01643SL0" alias $top

profile desk {
    output $laptop disable

    output $left   enable mode 2560x1440@59.951Hz position 0,1080 transform 90
    output $center enable mode 2560x1440@59.951Hz position 1440,1080
    output $right  enable mode 2560x1440@59.951Hz position 4000,1080 transform 270
    output $top    enable mode 1920x1080@60Hz     position 1760,0

    exec ~/.config/kanshi/scripts/apply-desk.sh
}

profile desknohdmi {
    output $laptop enable mode 1920x1080@59.999Hz position 0,1080
    output $center enable mode 2560x1440@59.951Hz position 1920,1080
    output $right  enable mode 2560x1440@59.951Hz position 4480,1080 transform 270
    output $top    enable mode 1920x1080@60Hz     position 2240,0

    exec ~/.config/kanshi/scripts/apply-desknohdmi.sh
}

profile nomad {
    output $laptop enable mode 1920x1080@59.999Hz position 0,0
}
{{- end }}
{{- if eq .env "home" }}
profile home {
    output "BNQ BenQ BL3290QT F7P00718019"

    output "BNQ BenQ GW2480 ETN9P01643SL0"

    output "BNQ BenQ BL2790QT L7P01778019"

    output "AU Optronics 0x2336 Unknown" {
        disable
    }

    exec /home/acampergue/.config/kanshi/scripts/home
}

profile laptop {
    output "AU Optronics 0x2336 Unknown" {
        enable
        mode 2560x1440
        position 0,0
        scale 1.6
    }
}
{{- end }}
